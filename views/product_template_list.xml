<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_tree_view_deposit_columns" model="ir.ui.view">
        <field name="name">product.template.list.deposit.optional.columns</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field
                    name="is_deposit"
                    optional="hide"
                    string="Is Deposit"
                />
                <field
                    name="deposit_product_id"
                    optional="hide"
                    string="Deposit Product"
                />
                <field
                    name="write_date"
                    optional="hide"
                    string="Dernière modification"
                />
            </xpath>
        </field>
    </record>
</odoo>
